# Copy this file to .env for local development only.
# Do not commit real secrets or production credentials.

KEY=replace-with-local-dev-key
SECRET=replace-with-local-dev-secret
PUBLIC_URL=http://localhost:8055

# Optional: Directus can create the first admin user from these values.
# You can also create the first admin from the onboarding screen.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-local-only
