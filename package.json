    "@angular/platform-server": "22.1.7",
    "@angular/router": "22.1.7",
    "@angular/ssr": "22.1.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.1.7",
    "@angular/cli": "22.1.7",
    "@angular/compiler-cli": "22.1.7",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
